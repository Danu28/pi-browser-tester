{
  "name": "pi-browser-tester",
  "version": "0.5.0",
  "description": "pi extension: drive a real Playwright-driven Chromium from the coding agent — website testing and browser actions plus unpacked-Chrome-extension testing (cext_* tools)",
  "keywords": ["pi-package", "browser", "e2e", "testing", "playwright", "chrome-extension"],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": ["./browser-tester/index.ts"]
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "check": "node browser-tester/scripts/smoke.mjs",
    "scenario": "node browser-tester/scripts/scenario.mjs",
    "install-browser": "node browser-tester/scripts/install-browser.mjs"
  }
}
